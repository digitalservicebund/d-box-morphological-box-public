if ! command -v cspell > /dev/null 2>&1; then
  echo "commit-msg: WARNING: 'cspell' command not found. Local commit message spell checking was skipped."
else
  if ! cspell --no-summary --no-progress --language-id commit-msg stdin://COMMIT_EDITMSG < "$1"; then
    echo "commit-msg: Aborted due to commit message spell checking issues. Please fix them before continuing."
    exit 1
  fi
fi

if ! command -v pnpm > /dev/null 2>&1; then
  echo "commit-msg: WARNING: 'pnpm' not found. Local commit linting skipped."
else
  if ! pnpm exec commitlint --edit "$1"
  then
    echo "commit-msg: Aborted due to commit message linting issues. Please ensure the commit message adheres to the conventional commit format defined for this project."
    exit 1
  fi
fi
