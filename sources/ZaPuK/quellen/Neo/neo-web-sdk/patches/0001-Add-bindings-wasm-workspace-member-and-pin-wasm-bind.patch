Add bindings/wasm to workspace and pin wasm-bindgen

The wasm binding crate generated by ubrn must be part of the Cargo
workspace so the second build pass can compile it.  wasm-bindgen is
pinned to an exact version to match the wasm-bindgen-cli version used
in the build pipeline.

Applied on top of the patches from neo-rust-sdk's own Makefile.
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -8,5 +8,6 @@
     "labs/*",
     "testing/*",
     "uniffi-bindgen",
+    "bindings/wasm",
     "xtask",
 ]
@@ -122,6 +123,6 @@
 vergen-gitcl = { version = "1.0.8", default-features = false }
 vodozemac = { version = "0.10.0", default-features = false, features = ["libolm-compat", "insecure-pk-encryption", "experimental-session-config"] }
-wasm-bindgen = { version = "0.2.105", default-features = false }
+wasm-bindgen = { version = "= 0.2.108", default-features = false }
 wasm-bindgen-test = { version = "0.3.55", default-features = false, features = ["std"] }
 web-sys = { version = "0.3.82", default-features = false }
 wiremock = { version = "0.6.5", default-features = false }
