{
  "name": "fit-neo-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://gitlab.opencode.de/fitko/matrix-g2x/fit-neo-web"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "lint:ci": "oxlint . --deny-warnings",
    "format:write": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "e2e": "playwright test",
    "test": "vitest",
    "extract-translations": "i18next \"src/**/*.{ts,tsx}\"",
    "stylelint:write": "stylelint \"src/**/*.css\" --fix",
    "stylelint:check": "stylelint \"src/**/*.css\""
  },
  "dependencies": {
    "@matrix-g2x/neo-web-sdk": "next",
    "@tanstack/react-virtual": "^3.14.3",
    "dompurify": "^3.4.11",
    "i18next": "^26.3.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-router": "^7.15.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10",
    "@storybook/addon-docs": "^10",
    "@storybook/addon-onboarding": "^10",
    "@storybook/addon-vitest": "^10",
    "@storybook/react-vite": "^10",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "browserslist": "^4.28.4",
    "eslint": "^9",
    "eslint-plugin-storybook": "^10",
    "i18next-parser": "^9.4.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright": "1.64.1",
    "sass": "^1.101.0",
    "storybook": "^10",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "resolutions": {
    "@matrix-g2x/neo-web-sdk/@ubjs/core": "0.31.0-3"
  },
  "browserslist": [
    "baseline widely available"
  ],
  "packageManager": "yarn@4.18.1"
}
