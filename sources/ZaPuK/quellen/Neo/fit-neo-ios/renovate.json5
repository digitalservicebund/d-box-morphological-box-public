{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:pinDigests"
  ],
  dependencyDashboard: true,
  labels: ["renovate"],
  vulnerabilityAlerts: {
    labels: ['security'],
  },
  osvVulnerabilityAlerts: true,
  prHourlyLimit: 0,
  minimumReleaseAge: '14 days',
  packageRules: [
    {
      matchManagers: ["swift"],
      groupName: "Swift"
    },
    {
      matchManagers: ["bundler"],
      groupName: "Ruby"
    },
    // Required because Matrix Rust SDK Swift bindings uses CalVer (YY.MM.DD)
    {
      matchDatasources: ["git-tags"],
      matchPackageNames: ["https://github.com/element-hq/matrix-rust-components-swift"],
      versioning: "regex:^(?<major>\\d{2})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})$"
    }
  ]
}
