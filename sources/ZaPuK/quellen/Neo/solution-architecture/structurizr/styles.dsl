styles {
    element "Person" {
        shape person
    }

    element "DB" {
        shape cylinder
    }

    element "Web" {
        shape WebBrowser
    }

    element "Mobile" {
        shape MobileDevicePortrait
    }

    element "Existing" {
        background #BBBBBB
    }

    element "Deploy" {
        background #0DBD8B
    }

    element "Develop" {
        background #F9D200
    }

    element "Legacy" {
        background #7D1E17
    }

    relationship "Legacy" {
        color #9A0B38
    }
}
