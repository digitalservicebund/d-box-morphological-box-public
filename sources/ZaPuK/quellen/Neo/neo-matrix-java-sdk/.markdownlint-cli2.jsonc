{
  "config": {
    // we can override default rules value in this section
    "line_length": {
      "code_blocks": false
    },
    "table": {
      "style": "compact",
      "aligned_delimiter": true
    }
  },
  "ignores": [
    ".gitlab/**/*.md",
    "bindings/src/main/rust/**/*"
  ],
  // Disable banner message on stdout (only valid at root)
  "noBanner": true,
  // Disable progress on stdout (only valid at root)
  "noProgress": true,
  // Use a specific formatter (only valid at root)
  "outputFormatters": [
    [
      "markdownlint-cli2-formatter-default"
    ]
  ]
}
