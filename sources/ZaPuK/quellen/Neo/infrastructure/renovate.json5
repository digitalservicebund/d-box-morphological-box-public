{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:pinDigests"
  ],
  dependencyDashboard: true,
  labels: ["renovate"],
  vulnerabilityAlerts: {
    labels: ['security'],
  },
  osvVulnerabilityAlerts: true,
  prHourlyLimit: 0,
  minimumReleaseAge: '14 days'
}
